# Copie para .env e ajuste. Todas as variáveis são opcionais em desenvolvimento.
NODE_ENV=development
# 127.0.0.1 aceita só conexões locais. Use 0.0.0.0 para acessar do emulador
# Android (10.0.2.2) ou de um celular na mesma rede.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/app.db
# Origens permitidas (CORS), separadas por vírgula. Em desenvolvimento,
# qualquer http://localhost:<porta> é aceito para o Flutter Web.
CORS_ORIGINS=
SESSION_TTL_DAYS=30
ENABLE_DOCS=true
LOG_LEVEL=info
# Atrás de proxy reverso (para o rate limit enxergar o IP real).
TRUST_PROXY=false

# IA: apenas no backend. Nunca coloque a chave no Flutter ou no Git.
VENICE_API_KEY=
# Opcional: ID de modelo de texto com supportsResponseSchema=true em GET /models.
# Vazio usa o modelo padrão compatível do Venice (ou o primeiro compatível).
VENICE_MODEL=
# Cota por conta compartilhada entre chat e quiz; renova à meia-noite de Brasília.
# 0 bloqueia a geração de IA para todos. Tentativas admitidas contam inclusive em falhas.
AI_DAILY_LIMIT=20
